{
  "name": "@satpath/gateless",
  "version": "0.4.2",
  "type": "module",
  "description": "Sovereign L402 on Lightning - client for AI agents, server middleware for merchants, browser-compatible NWC",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "browser": {
    "ws": false
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "tsc && node dist/test/test-e2e.js && node dist/test/test-nwc.js && node dist/test/test-server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lightning",
    "bitcoin",
    "l402",
    "lsat",
    "macaroon",
    "ai-agent",
    "payments",
    "lnd",
    "nwc",
    "nostr",
    "nostr-wallet-connect",
    "micropayments"
  ],
  "author": "satpath",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satpathdev/gateless"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "nostr-tools": "^2.23.1",
    "ws": "^8.19.0"
  }
}
